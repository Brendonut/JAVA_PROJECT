package lacorte_methodactivity;
public class Lacorte_methodActivity {
    
    static int calculate(int x, int y) {
        return x + y;
    }
    
    static double calculate(double x, double y, char operator) {
        switch (operator) {
            case '-':
                return x - y;
               
            case '+':
                return x + y;
                
            case '*':
                return x * y;
                
            case '/':
                return x / y;
            default:
                System.out.println("INVALID OPERATOR");
                break;
        }
        return 0;
    }
    public static void main(String[] args) {
        System.out.println("Addition: " + calculate(2.5, .5, '2'));
        System.out.println("Subtraction: " + calculate(2.5, .5, '-'));
        System.out.println("Multiplication: " + calculate(2.5, .5, '*'));
        System.out.println("Division: " + calculate(2.5, .5, '/'));
    }
    
}
